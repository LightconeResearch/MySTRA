{
  "name": "@astra-spec/mystra",
  "version": "0.0.1",
  "description": "A MyST plugin that imports/cites ASTRA analysis components into Markdown reports",
  "type": "module",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "astra",
    "myst",
    "mystmd",
    "research",
    "reproducibility",
    "markdown",
    "plugin",
    "scientific-computing",
    "publishing"
  ],
  "homepage": "https://astra-spec.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightconeResearch/MySTRA"
  },
  "dependencies": {
    "@astra-spec/sdk": "^0.0.3",
    "myst-parser": "^1.7.1",
    "myst-spec": "^0.0.5",
    "papaparse": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.6"
  }
}
