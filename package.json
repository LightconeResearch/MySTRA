{
  "name": "@astra-spec/mystra",
  "version": "0.0.1",
  "description": "A MyST plugin that imports/cites ASTRA analysis components into Markdown reports",
  "type": "module",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./publication": {
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    },
    "./mystra.mjs": "./dist/mystra.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/publication.js",
    "dist/publication.d.ts",
    "dist/publication.d.ts.map",
    "dist/publication.js.map",
    "src/publication.ts",
    "dist/mystra.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "uvx zensical serve",
    "docs:build": "uvx zensical build --strict",
    "clean": "rm -rf dist",
    "test:bundle": "npm run bundle && node scripts/check-bundle.mjs",
    "prepack": "npm run build && npm run bundle"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astra",
    "myst",
    "mystmd",
    "research",
    "reproducibility",
    "markdown",
    "plugin",
    "scientific-computing",
    "publishing"
  ],
  "homepage": "https://astra-spec.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-project/MySTRA.git"
  },
  "peerDependencies": {
    "@astra-spec/sdk": "^0.2.0-rc1"
  },
  "overrides": {
    "intersphinx": "1.0.2"
  },
  "devDependencies": {
    "@astra-spec/sdk": "0.2.0-rc1",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.0",
    "esbuild": "^0.28.0",
    "myst-common": "^1.9.5",
    "myst-parser": "^1.7.1",
    "myst-transforms": "1.3.49",
    "papaparse": "^5.4.0",
    "punycode": "^2.3.1",
    "typescript": "^5.5.0",
    "vfile": "^5.3.7",
    "vitest": "4.1.6",
    "yaml": "^2.6.1"
  }
}
